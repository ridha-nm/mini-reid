# Mini-Reid — copy to .env and fill in. NEVER commit .env.

GEMINI_API_KEY=

# Paths to existing read-only credentials. Point these at the agent's own
# credentials once they exist.
GMAIL_CREDS=~/.gmail-mcp/credentials.json
GMAIL_TOKEN=~/.gmail-mcp/token.json

# Mini-Reid Slack app (manifest: slack-app-manifest.yaml)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_OWNER_ID=

# Jira — token from id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
