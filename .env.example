# Mini-Reid — copy to .env and fill in. NEVER commit .env.

GEMINI_API_KEY=

# Paths to existing read-only credentials. Point these at the agent's own
# credentials once they exist.
GMAIL_CREDS=~/.gmail-mcp/credentials.json
GMAIL_TOKEN=~/.gmail-mcp/token.json

# Mini-Reid Slack app (manifest: slack-app-manifest.yaml)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_OWNER_ID=
# Workspace subdomain, used in Slack archive links (e.g. gopantas).
SLACK_TEAM=

# Slack user IDs allowed to use `ask:` (comma-separated). Owner is always allowed.
KB_ALLOWLIST=
# Extra local folders/files to index for the knowledge base (comma-separated).
KB_PATHS=
# Local Ollama model used only to reword tasks. Optional.
OLLAMA_MODEL=

# Self-serve member setup page. Set SETUP_BASE_URL to the HTTPS address
# teammates can reach (Tailscale Funnel, Caddy, or a LAN hostname).
SETUP_PORT=8765
SETUP_BASE_URL=
# Hosted OAuth relay (Cloud Run). RELAY_KEY authenticates the Mac poller.
RELAY_URL=
RELAY_KEY=
# Web-application OAuth client used only by the member setup page. Keep
# GMAIL_CREDS for the owner's existing token. When the setup page is not on
# HTTPS, Google's registered loopback URI is used instead.
SETUP_GOOGLE_CREDS=
SETUP_GOOGLE_REDIRECT_URI=

# Jira — token from id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
